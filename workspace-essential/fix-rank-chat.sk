# Apply the MerelyMe resource-pack rank badges to chat and TAB.
# /fixrankchat

options:
	prefix: &b&lRANKS &8» &7

function applyRankPrefixes():
	execute console command "lp group default meta setprefix 1 "" &f"""
	execute console command "lp group member meta setprefix 10 "" &f"""
	execute console command "lp group booster meta setprefix 15 "" &f"""
	execute console command "lp group knight meta setprefix 20 "" &f"""
	execute console command "lp group warrior meta setprefix 30 "" &f"""
	execute console command "lp group macer meta setprefix 40 "" &f"""
	execute console command "lp group prime meta setprefix 50 "" &f"""
	execute console command "lp group clipper meta setprefix 55 "" &f"""
	execute console command "lp group media meta setprefix 60 "" &f"""
	execute console command "lp group helper meta setprefix 80 "" &f"""
	execute console command "lp group mod meta setprefix 90 "" &f"""
	execute console command "lp group admin meta setprefix 95 "" &f"""
	execute console command "lp group owner meta setprefix 100 "" &f"""
	execute console command "tab reload"

function applyWhiteTabNames():
	loop all players:
		execute console command "tab player %name of loop-player% customtabname &f%name of loop-player%"

command /fixrankchat:
	permission: op
	trigger:
		send "{@prefix}&7A aplicar ranks no chat + TAB..." to player
		applyRankPrefixes()
		wait 1 second
		applyWhiteTabNames()
		send "{@prefix}&aPronto! Badges gráficos aplicados no chat e no TAB." to player

on load:
	wait 5 seconds
	applyRankPrefixes()
	wait 2 seconds
	applyWhiteTabNames()
	broadcast "&b&lRANKS &8» &aChat/TAB ranks atualizados."

on join:
	wait 3 seconds
	execute console command "tab player %name of player% customtabname &f%name of player%"
